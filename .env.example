# ===== Supabase (panel de Supabase → Project Settings → API) =====
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Nunca en el navegador ni en el repositorio.
SUPABASE_SERVICE_ROLE_KEY=

# Conexión directa a Postgres: solo para aplicar migraciones desde tu equipo (Project Settings → Database).
# Si la contraseña tiene símbolos (@ & ?), escríbelos codificados (%40 %26 %3F).
DATABASE_URL=

# ===== Correo (SMTP). Ejemplo con Gmail y contraseña de aplicación =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=HEMOCAX - Banco de Sangre HRDC

# false = envía correos de verdad. Cualquier otro valor SIMULA el envío (no sale nada).
AUTOMATION_DRY_RUN=true

# ===== Recordatorios automáticos =====
# Secreto compartido entre el reloj (Render) y el portal (Vercel). Debe ser igual en ambos.
AUTOMATION_RUN_SECRET=
# Solo en el reloj (Render):
AUTOMATIONS_ENABLED=false
AUTOMATION_TIMEZONE=America/Lima
HEMOCAX_API_URL=https://tu-portal.vercel.app

# ===== Opcional =====
# Dirección que aparece en los botones de los correos (por defecto se deduce de Vercel).
NEXT_PUBLIC_SITE_URL=
